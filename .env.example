# Where private client data lives (samples, gold, runs). Never inside a tracked folder.
DATA_DIR=./data/private

# n8n instance the pipeline runs on (public API key, sent as X-N8N-API-KEY)
N8N_API_URL=https://n8n.example.com
N8N_API_KEY=

# Worker workflow IDs on that instance
WF_CLEAN=
WF_TRANSLATE=
WF_CATEGORISE=

# Postgres holding the app data, reached as: ssh <target> docker exec <container> psql -U <user> -d <name>
DB_SSH_TARGET=root@db.example.com
DB_SSH_KEY=~/.ssh/id_ed25519
DB_CONTAINER=postgres
DB_USER=postgres
DB_NAME=app
