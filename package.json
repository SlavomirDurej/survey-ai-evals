{
  "name": "survey-ai-evals",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluating an LLM pipeline that cleans, translates and categorises multilingual survey quotes, against a year of human labels.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build-sample": "node --env-file-if-exists=.env --import tsx src/scripts/build-sample.ts",
    "split-upload": "node --env-file-if-exists=.env --import tsx src/scripts/split-upload.ts",
    "save-success": "node --env-file-if-exists=.env --import tsx src/scripts/save-success.ts",
    "export-run": "node --env-file-if-exists=.env --import tsx src/scripts/export-run.ts",
    "score-run": "node --env-file-if-exists=.env --import tsx src/scripts/score-run.ts",
    "run-cost": "node --env-file-if-exists=.env --import tsx src/scripts/run-cost.ts",
    "taxonomy-pick": "node --env-file-if-exists=.env --import tsx src/scripts/taxonomy-pick.ts",
    "taxonomy-structure": "node --env-file-if-exists=.env --import tsx src/scripts/taxonomy-structure.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
